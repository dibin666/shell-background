{
  "name": "@pify/shell-background",
  "version": "0.4.0",
  "description": "Long-running bash goes async: background: true launches detached, and any command still running after 30s auto-backgrounds and delivers its result when it finishes",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pify",
    "bash",
    "background",
    "async",
    "shell"
  ],
  "homepage": "https://github.com/pifydev/shell-background#readme",
  "bugs": {
    "url": "https://github.com/pifydev/shell-background/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pifydev/shell-background.git"
  },
  "license": "MIT",
  "author": "Pify maintainers",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/shell-background.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.0",
    "@earendil-works/pi-coding-agent": "^0.99.0",
    "@earendil-works/pi-tui": "^0.99.0",
    "@types/node": "^22.10.2",
    "typebox": "^1.1.38",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
